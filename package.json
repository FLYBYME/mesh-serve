{
    "name": "@flybyme/mesh-serve",
    "version": "0.3.3",
    "description": "The serving half of the platform: build a repository into content-addressed artifacts, and serve them by hostname.",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": "./*",
        "./package.json": "./package.json"
    },
    "bin": {
        "mesh-serve": "./bin/mesh-serve.mjs"
    },
    "files": [
        "bin",
        "dist",
        "README.md"
    ],
    "scripts": {
        "prepare": "npm run build",
        "generate": "tsx src/cli/core/generate-cli.ts",
        "build": "npm run generate && tsc -p tsconfig.json",
        "typecheck": "npm run generate && tsc -p tsconfig.check.json --noEmit",
        "//test": "typecheck first, because vitest transpiles without typechecking -- so the suite could be green while the compiler was not, and was, for six errors across two files. See roadmap F31.",
        "test": "npm run typecheck && vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@flybyme/mesh": "github:FLYBYME/mesh#v3.1.5",
        "@flybyme/mesh-web": "github:FLYBYME/mesh-web#v0.17.1",
        "commander": "^15.0.0",
        "esbuild": "^0.28.2",
        "json-schema-to-zod": "^2.8.1",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "mongodb": "^6.0.0",
        "puppeteer-core": "^25.11.0",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    },
    "license": "UNLICENSED"
}
