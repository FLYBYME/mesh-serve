# A node's environment. Copy to `.env` beside this file; `bin/node.mjs` reads it
# at startup, before anything else, and never overwrites a value already exported.
#
#     cp .env.example .env && ${EDITOR:-nano} .env
#
# `.env` is gitignored. This file is not, and must never hold a real value.
#
# Nothing here belongs on a command line. A value typed as `MESH_KEY=… node bin/node.mjs`
# is visible in `ps` to every user on the machine and is written to the shell history
# of whoever typed it — and this one is the key to the mesh.


# ---------------------------------------------------------------- the mesh

# The handshake key. **Every node on one mesh has the same value**, and a node
# whose key does not match is refused at the transport rather than at a contract.
#
# Required before a node may bind anything but loopback: `--ws-host 0.0.0.0` with
# no key is refused at boot, which is the error that sends people here. A node
# that only dials out (the laptop, a builder, a private VPS) binds 127.0.0.1 and
# still needs the key to be let in by the one that listens.
#
#     openssl rand -hex 32
MESH_KEY=

# Which node to join through — the one machine with a public mesh port.
# Comma-separated. Empty on that machine itself, because it is what others dial.
#
#     MESH_BOOTSTRAP=ws://surf.surfdns.net:4001
MESH_BOOTSTRAP=

# ---------------------------------------------------------------- the database

# One cluster, one database. Every node on the mesh points at the same one.
#
#     mongodb://localhost:27017
#     mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#
# A password here is a real credential: rotate it if it is ever printed, pasted
# into a terminal that is being recorded, or committed.
MONGODB_URI=

# ---------------------------------------------------------------- the builder

# A token per forge host, for cloning private repositories: the host uppercased
# with dots as underscores. `GIT_TOKEN` alone covers a node that talks to one.
#
# Only a node that actually builds needs one. A node holding a token can clone
# every repository that token can read, which is why `builder.build_start` takes
# a part rather than a repository URL.
#GIT_TOKEN_GITHUB_COM=
#GIT_TOKEN=

# Where built artifacts are cached on this machine's disk. A cache, not storage:
# deleting it is safe and the version rebuilds from its commit.
#MESH_BLOB_ROOT=./.artifacts

# ---------------------------------------------------------------- serving

# The origin a browser is told to fetch artifacts from. It must be reachable
# *from the browser*, so `127.0.0.1` is right only when the browser is on this
# same machine.
#
#     CDN_URL=https://cdn.surfdns.net
#CDN_URL=
